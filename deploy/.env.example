# Copy to ~/.config/litsi/deploy.env, OUTSIDE the repository/build context.
# Hostname only: no scheme, port, or path. Point public DNS at this machine.
LITSI_DOMAIN=call.example.com

# Server-only Cloudflare TURN key ID and its API token. Never use NUXT_PUBLIC_ here.
# https://developers.cloudflare.com/realtime/turn/generate-credentials/
NUXT_TURN_ID=
NUXT_TURN_TOKEN=

# Optional: leave blank to disable analytics entirely.
NUXT_PUBLIC_TELEMETRYDECK_APP_ID=
# Optional documentation destination shown by the app.
NUXT_PUBLIC_DOCS_URL=https://litsi.nirjan.dev/
