# Cloudflare TURN
# https://developers.cloudflare.com/calls/turn/generate-credentials/

NUXT_TURN_ID=
NUXT_TURN_TOKEN=

# Optional usage analytics. Leave blank to disable; no account is needed to run Litsi.
# https://telemetrydeck.com/docs/guides/javascript-setup/
NUXT_PUBLIC_TELEMETRYDECK_APP_ID=

# Optional URL of your independently deployed documentation site.
NUXT_PUBLIC_DOCS_URL=https://litsi.nirjan.dev/